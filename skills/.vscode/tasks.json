{
  "version": "2.0.0",
  "tasks": [
    { "label": "Skills: interactive demo", "type": "process", "command": "node", "args": ["scripts/demo.mjs"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "Skills: prepare exercise", "type": "process", "command": "node", "args": ["scripts/setup.mjs", "${input:exercise}"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "Skills: check learner work", "type": "process", "command": "node", "args": ["scripts/check.mjs", "${input:exercise}"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "Skills: show defective baseline", "type": "process", "command": "node", "args": ["scripts/check.mjs", "${input:exercise}", "--baseline"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] }
  ],
  "inputs": [
    { "id": "exercise", "type": "pickString", "description": "Choose an independent exercise", "options": ["01-clarify", "02-ground", "03-honest-tests", "04-simplify", "05-debug", "06-failure-paths", "07-review", "08-capstone"] }
  ]
}
